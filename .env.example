# 城市防灾应急物资调度系统 rescue-stock
# 复制本文件为 .env：cp .env.example .env

# Compose
COMPOSE_PROJECT_NAME=rescue-stock

# 端口（前端容器内固定 80，后端容器内固定 8080）
FRONTEND_PORT=20102
BACKEND_PORT=21102
DB_PORT=33060

# 数据库（MySQL 8.0）
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=app_password

# 后端
JWT_SECRET=local-dev-secret-change-me
